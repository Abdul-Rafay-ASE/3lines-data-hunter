# Excel files (data, never source)
*.xlsx
*.xls
~$*

# Local SQLite database
*.db
*.db-shm
*.db-wal

# IDE
.vscode/
.idea/

# Python cache / virtualenvs
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Git
.git/
.gitignore

# Environment / secrets — never bake into the image
.env
.env.*

# Auto-downloaded Chrome for Testing (host artifact)
.chrome-for-testing/

# Logs
logs/
*.log

# Archived POC scripts — not shipped in the production image
legacy/

# Docs / repo metadata not needed in the image
*.md
nul
*.bat
