# 3LINES DataHunter — Configuration
#
# Copy this file to `.env` and adjust values. All variables are OPTIONAL —
# the app uses safe defaults when a variable is unset or empty.
#
#   cp .env.example .env

# ──────────────────────────────────────────────────────────────────
# Scraping
# ──────────────────────────────────────────────────────────────────

# Default target URL shown in the Scraper tab (user can still override in the UI).
DEFAULT_TARGET_URL=https://www.lqlite.com

# Hard ceiling on the number of parallel scraper bots the UI will allow.
# Defaults to 10 in code; set this lower for safer / more conservative scraping.
DH_MAX_BOTS=10

# Auto-save snapshot interval (records). Lower = more frequent autosaves but more I/O.
DH_AUTOSAVE_INTERVAL=50

# Per-stock wall-clock timeout in seconds. Stocks that take longer than this
# are abandoned, marked as failed, and the worker reboots its driver before
# moving on. Default 60s.
DH_PER_STOCK_TIMEOUT=60

# ──────────────────────────────────────────────────────────────────
# Access control
# ──────────────────────────────────────────────────────────────────

# Optional simple password gate.
#   Empty / unset → gate disabled (current behavior).
#   Set to a value → users must enter it before reaching the app.
# Use a long random string in any non-local deployment.
DH_PASSWORD=
